<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Brand palette and shared styles, taken from the login and splash designs.

    Everything visual lives here rather than on individual pages. Six screens
    styled inline become six screens that drift apart; six screens built from
    these styles stay one application. Changing the brand later means editing
    this file, not hunting through XAML.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================ COLOURS -->

    <!-- Purple, sampled from the design -->
    <Color x:Key="BrandDeep">#2A0A4A</Color>
    <Color x:Key="BrandPurple">#5B2E9D</Color>
    <Color x:Key="BrandPurpleLight">#8B5CD6</Color>
    <Color x:Key="BrandAccent">#A77BF3</Color>
    <Color x:Key="BrandInk">#241245</Color>

    <!-- Neutrals for the light screens -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F4F2F9</Color>
    <Color x:Key="TextPrimary">#241245</Color>
    <Color x:Key="TextSecondary">#6B6480</Color>
    <Color x:Key="TextMuted">#9A94A8</Color>
    <Color x:Key="FieldBorder">#DCD7E8</Color>
    <Color x:Key="FieldBorderFocused">#8B5CD6</Color>

    <!-- Feedback -->
    <Color x:Key="Success">#0F5132</Color>
    <Color x:Key="SuccessBg">#D1E7DD</Color>
    <Color x:Key="Danger">#8C1D18</Color>
    <Color x:Key="DangerBg">#F9DEDC</Color>

    <!-- ============================================================ BRUSHES -->

    <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandPurple}" Offset="0.0" />
        <GradientStop Color="{StaticResource BrandPurpleLight}" Offset="1.0" />
    </LinearGradientBrush>

    <!--
        Used behind the splash until the artwork is supplied, and as the
        fallback if an image ever fails to load. A branded screen should never
        fall back to a blank white page.
    -->
    <LinearGradientBrush x:Key="SplashGradient" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1A0533" Offset="0.0" />
        <GradientStop Color="{StaticResource BrandDeep}" Offset="0.45" />
        <GradientStop Color="#3D1470" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ======================================================= TYPOGRAPHY -->

    <Style x:Key="DisplayTitle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Subtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="2,0,0,-4" />
    </Style>

    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource BrandPurpleLight}" />
    </Style>

    <Style x:Key="FootnoteLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ========================================================== BUTTONS -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandPurpleLight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- ============================================================= CARD -->

    <!--
        The frosted-glass card from the design.

        MAUI has no cross-platform blur, so this is a near-opaque white surface
        with a soft shadow over the background image. At the opacity used in the
        design the difference is only visible side by side, and the alternative
        — a platform-specific blur effect — would be a lot of code for a
        subtle gain.
    -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#F7FFFFFF" />
        <Setter Property="Stroke" Value="#33FFFFFF" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="26,32" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#40241245" Offset="0,10" Radius="26" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Feedback banner shared by every form -->
    <Style x:Key="MessageCard" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
