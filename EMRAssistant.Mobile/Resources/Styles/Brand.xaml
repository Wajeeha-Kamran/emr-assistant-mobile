<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Brand palette and shared styles, taken from the login and splash designs.

    Everything visual lives here rather than on individual pages. Six screens
    styled inline become six screens that drift apart; six screens built from
    these styles stay one application. Changing the brand later means editing
    this file, not hunting through XAML.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <!-- ============================================================ COLOURS -->

    <!-- Purple, sampled from the design -->
    <Color x:Key="BrandDeep">#2A0A4A</Color>
    <Color x:Key="BrandPurple">#5B2E9D</Color>
    <Color x:Key="BrandPurpleLight">#8B5CD6</Color>
    <Color x:Key="BrandAccent">#A77BF3</Color>
    <Color x:Key="BrandInk">#241245</Color>

    <!-- Neutrals for the light screens -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F4F2F9</Color>
    <Color x:Key="TextPrimary">#241245</Color>
    <Color x:Key="TextSecondary">#6B6480</Color>
    <Color x:Key="TextMuted">#9A94A8</Color>
    <Color x:Key="FieldBorder">#DCD7E8</Color>
    <Color x:Key="FieldBorderFocused">#8B5CD6</Color>

    <!-- Security accent. Green reads as "safe" almost universally in an
         interface, which is the point of the access notice. -->
    <Color x:Key="SecureGreen">#1F8A5B</Color>

    <!--
        Dashboard status tints.

        Three levels, because the attention list holds three kinds of problem
        and colour is what lets a doctor read the card without reading it. Amber
        is "the machine stopped", purple is "your turn", red is "it did not
        reach the EMR". Each is a pale tile with a saturated glyph, so five rows
        stacked together stay calm rather than shouting.
    -->
    <Color x:Key="TileWarning">#FFF0E3</Color>
    <Color x:Key="InkWarning">#E07B39</Color>

    <Color x:Key="TileAccent">#EDE7FB</Color>
    <Color x:Key="InkAccent">#5B2E9D</Color>

    <Color x:Key="TileDanger">#FDE9E9</Color>
    <Color x:Key="InkDanger">#E5484D</Color>

    <Color x:Key="TileSecure">#E9F7F0</Color>
    <Color x:Key="TileNotice">#EFEBFB</Color>

    <!-- Feedback -->
    <Color x:Key="Success">#0F5132</Color>
    <Color x:Key="SuccessBg">#D1E7DD</Color>
    <Color x:Key="Danger">#8C1D18</Color>
    <Color x:Key="DangerBg">#F9DEDC</Color>

    <!-- ============================================================ BRUSHES -->

    <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandPurple}" Offset="0.0" />
        <GradientStop Color="{StaticResource BrandPurpleLight}" Offset="1.0" />
    </LinearGradientBrush>

    <!--
        Used behind the splash until the artwork is supplied, and as the
        fallback if an image ever fails to load. A branded screen should never
        fall back to a blank white page.
    -->
    <LinearGradientBrush x:Key="SplashGradient" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1A0533" Offset="0.0" />
        <GradientStop Color="{StaticResource BrandDeep}" Offset="0.45" />
        <GradientStop Color="#3D1470" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ======================================================= TYPOGRAPHY -->
    <!--
        Playfair Display for headings, Inter for everything read for content.

        Display type can afford personality; text a clinician reads for accuracy
        should be as plain as possible. Inter was drawn for screens and holds up
        at the small sizes the transcript and SOAP screens will need.

        The pairing is deliberate and one-directional: the serif never carries
        clinical content. A transcript line or a SOAP section set in Playfair
        would be harder to scan and would dress up text whose only job is to be
        read exactly.
    -->

    <!-- Applies to every Label and Entry with no explicit family, so the whole
         app moves off the platform default. Without this, the same screen
         renders in Segoe UI on Windows, Roboto on Android and SF Pro on iOS. -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="PlayfairSemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Subtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="2,0,0,-4" />
    </Style>

    <Style x:Key="LinkLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource BrandPurpleLight}" />
    </Style>

    <!-- The hero line. Medium rather than Regular: at this size Playfair's
         Regular reads as thin next to the solid gradient button beneath it. -->
    <Style x:Key="DisplaySerif" TargetType="Label">
        <Setter Property="FontFamily" Value="PlayfairMedium" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
    </Style>

    <Style x:Key="Greeting" TargetType="Label">
        <Setter Property="FontFamily" Value="PlayfairBold" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="PlayfairSemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
    </Style>

    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="RowMeta" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="FootnoteLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- ========================================================== BUTTONS -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonGradient}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderWidth" Value="0" />

        <!--
            Scale feedback is applied by HoverScaleBehavior rather than here.
            A VisualState sets Scale instantly, which snaps; the behaviour
            animates it. Only opacity, which reads acceptably as a step change,
            is left to the state manager.
        -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1.0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrandPurpleLight}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- ============================================================= CARD -->

    <!--
        The frosted-glass card from the design.

        MAUI has no cross-platform blur, so this is a near-opaque white surface
        with a soft shadow over the background image. At the opacity used in the
        design the difference is only visible side by side, and the alternative
        — a platform-specific blur effect — would be a lot of code for a
        subtle gain.
    -->
    <!--
        Frosted glass, as far as it can be taken without a blur.

        The first version used a near-opaque white fill, which reads as a plain
        white panel rather than glass. Glass is legible because you can see
        something through it, so this version is considerably more transparent
        and uses a vertical gradient rather than a flat fill: brighter at the
        top where light would catch, clearer lower down. The border is also
        lighter at the top edge for the same reason.

        This only looks like glass if there is something behind it. See the
        login page, where the hero image now extends underneath the card.
    -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E8FFFFFF" Offset="0.0" />
                    <GradientStop Color="#CCFFFFFF" Offset="0.55" />
                    <GradientStop Color="#DBFFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <!-- A purple edge rather than a white one: it defines the card
             against light artwork, and ties the panel to the brand. Kept low
             in opacity so it reads as an edge, not an outline. -->
        <Setter Property="Stroke">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#998B5CD6" Offset="0.0" />
                    <GradientStop Color="#4D8B5CD6" Offset="0.5" />
                    <GradientStop Color="#805B2E9D" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Padding" Value="26,32" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="26" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#40241245" Offset="0,10" Radius="26" Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Feedback banner shared by every form -->
    <Style x:Key="MessageCard" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ ICONS -->
    <!--
        Drawn as vector paths rather than emoji or an icon font. Emoji render
        in colour at the platform's own weight, which clashes with a fine-lined
        interface; an icon font would be another asset to ship. All are drawn on
        a 24x24 grid and scaled with Aspect="Uniform".
    -->
    <shapes:PathGeometry x:Key="IconMail"
        Figures="M2,5 L22,5 L22,19 L2,19 Z M2,5 L12,13.5 L22,5" />

    <shapes:PathGeometry x:Key="IconLock"
        Figures="M4.5,10.5 L19.5,10.5 L19.5,21 L4.5,21 Z M8,10.5 L8,7 A4,4 0 0 1 16,7 L16,10.5" />

    <!--
        Drawn taller than a typical eye glyph. The outline spans the full 24
        units horizontally but only about 11 vertically, and Aspect="Uniform"
        scales to the wider dimension, so a wide, flat path renders as a thin
        sliver in a square box. Narrowing the width and increasing the height
        brings the proportions closer to the intended shape.
    -->
    <shapes:PathGeometry x:Key="IconEye"
        Figures="M3.2,12 C6.4,5.4 17.6,5.4 20.8,12 C17.6,18.6 6.4,18.6 3.2,12 Z M12,8.4 A3.6,3.6 0 1 1 11.99,8.4 Z" />

    <!--
        The shoulders are a flat-topped rounded shape, not a curve.

        The first version drew them as a single shallow bezier
        (C3.8,16.2 20.2,16.2 20.2,21), which dipped only five units below the
        head. At 19px that reads as a circle with an unrelated line beneath it
        rather than a person. Squaring the top of the shoulders and bringing
        them up to meet the head gives the silhouette something to be
        recognised by.
    -->
    <shapes:PathGeometry x:Key="IconUser"
        Figures="M12,3 A4,4 0 1 1 11.99,3 Z M20,21 L20,19 A4,4 0 0 0 16,15 L8,15 A4,4 0 0 0 4,19 L4,21" />

    <shapes:PathGeometry x:Key="IconMic"
        Figures="M9,6 A3,3 0 0 1 15,6 L15,12 A3,3 0 0 1 9,12 Z M5.5,11.5 C5.5,17.5 18.5,17.5 18.5,11.5 M12,17.8 L12,21 M8.5,21 L15.5,21" />

    <!--
        A waveform, not a warning triangle. The row says transcription failed,
        and the icon should name the thing that failed rather than restate the
        severity the colour already carries.
    -->
    <shapes:PathGeometry x:Key="IconWaveform"
        Figures="M3,12 L6.5,12 L8,6.5 L9.5,17.5 L11,9 L12.5,15 L14,7 L15.5,16 L17,11 L21,11" />

    <shapes:PathGeometry x:Key="IconWaveformClock"
        Figures="M3,12 L5.5,12 L7,7 L8.5,17 L10,10.5 L11.5,14 L13,12 M18,13 A4,4 0 1 1 17.99,13 Z M18,14.7 L18,17 L19.9,18" />

    <shapes:PathGeometry x:Key="IconDocument"
        Figures="M6,3 L14,3 L18,7 L18,21 L6,21 Z M14,3 L14,7 L18,7 M9,12 L15,12 M9,16 L15,16" />

    <shapes:PathGeometry x:Key="IconPen"
        Figures="M5,17.2 L5.8,13.9 L15.6,4.1 A2.2,2.2 0 0 1 18.7,7.2 L8.9,17 Z M3.5,20.8 C7,19 10,22 13.5,20.3 C16,19.1 18,20 20.5,20.8" />

    <shapes:PathGeometry x:Key="IconCloudSlash"
        Figures="M18,10 L16.74,10 A8,8 0 1 0 9,20 L18,20 A5,5 0 0 0 18,10 Z M4.5,4.5 L19.5,19.5" />

    <shapes:PathGeometry x:Key="IconShieldCheck"
        Figures="M12,2.5 L20,6 L20,12 C20,17 16,20.5 12,21.5 C8,20.5 4,17 4,12 L4,6 Z M8.6,12.2 L11.2,14.8 L15.6,10.2" />

    <shapes:PathGeometry x:Key="IconCheck"
        Figures="M4,12.5 L9.5,18 L20,6.5" />

    <shapes:PathGeometry x:Key="IconSignOut"
        Figures="M9,4.5 L4.5,4.5 L4.5,19.5 L9,19.5 M11,12 L19.5,12 M16,8 L20,12 L16,16" />

    <shapes:PathGeometry x:Key="IconShield"
        Figures="M12,2.5 L20,6 L20,12 C20,17 16,20.5 12,21.5 C8,20.5 4,17 4,12 L4,6 Z" />

</ResourceDictionary>
