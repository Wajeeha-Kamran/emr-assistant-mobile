<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EMRAssistant.Mobile.Views.ProcessingPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">

    <!--
        Screen 6. What the doctor sees between Finish and the note being ready.

        Two stages, not three. Speech recognition and speaker separation are one
        background job with one status, so a row ticking "speakers identified"
        before the transcript completes would report something the server does
        not know.

        No percentage and no countdown anywhere: the API reports neither, and a
        bar filling at an invented rate is a claim a doctor will eventually
        catch out.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="0" Spacing="0">

            <!-- ================================================== HEADER -->
            <Grid HeightRequest="252">

                <Border StrokeThickness="0" InputTransparent="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#742AD8" Offset="0.0" />
                            <GradientStop Color="#30087C" Offset="0.55" />
                            <GradientStop Color="#100238" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,32,32" />
                    </Border.StrokeShape>
                </Border>

                <Border StrokeThickness="0" InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,32,32" />
                    </Border.StrokeShape>
                    <Image Source="processing_hero.jpg"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Border>

                <Grid RowDefinitions="Auto,*" Padding="18,16,18,0">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Grid Grid.Column="0" WidthRequest="38" HeightRequest="38">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="#26FFFFFF" StrokeThickness="0" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="19" />
                                </Border.StrokeShape>
                            </Border>
                            <Path Data="M15,5 L8,12 L15,19 M8,12 L21,12"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Aspect="Uniform"
                                  WidthRequest="17" HeightRequest="17"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  InputTransparent="True" />
                        </Grid>

                        <Image Grid.Column="2"
                               Source="logo_lockup_white.png"
                               Aspect="AspectFit" HeightRequest="26"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="0,14,0,0"
                                         VerticalOptions="Start"
                                         WidthRequest="215" HorizontalOptions="Start">
                        <Label Text="AI PROCESSING"
                               FontFamily="InterSemiBold" FontSize="10.5"
                               CharacterSpacing="2"
                               TextColor="#B9A2E8" />
                        <BoxView WidthRequest="26" HeightRequest="2.5"
                                 Color="#B9A2E8"
                                 HorizontalOptions="Start"
                                 Margin="0,6,0,10" />
                        <Label Text="Preparing your note"
                               FontFamily="PlayfairBold" FontSize="26"
                               LineHeight="1.22" TextColor="White" />
                        <Label x:Name="SubtitleLabel"
                               FontFamily="InterRegular" FontSize="11.5"
                               TextColor="#A6FFFFFF"
                               Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- ==================================================== BODY -->
            <VerticalStackLayout Padding="14,0,14,26" Spacing="0"
                                 MaximumWidthRequest="520" HorizontalOptions="Center">

                <Grid Margin="0,-40,0,0">

                    <Border BackgroundColor="{StaticResource Surface}"
                            StrokeThickness="0" InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#26241245" Offset="0,10" Radius="24" Opacity="0.6" />
                        </Border.Shadow>
                    </Border>

                    <!-- ================================== STAGES -->
                    <VerticalStackLayout x:Name="StagesView" Margin="18,20" Spacing="0">

                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                            <Border x:Name="StageOneTile" Grid.Column="0"
                                    WidthRequest="52" HeightRequest="52" Padding="0"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Path x:Name="StageOneIcon"
                                      Data="{StaticResource IconWaveform}"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform"
                                      WidthRequest="24" HeightRequest="24"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Transcribing and separating speakers"
                                       Style="{StaticResource RowTitle}" />
                                <Label x:Name="StageOneStatus"
                                       Style="{StaticResource RowMeta}" />
                            </VerticalStackLayout>

                            <Label x:Name="StageOneMark" Grid.Column="2"
                                   FontSize="18" VerticalOptions="Center"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>

                        <!-- The connector. Solid once the stage above is done. -->
                        <BoxView x:Name="Connector"
                                 WidthRequest="1.5" HeightRequest="26"
                                 Color="{StaticResource FieldBorder}"
                                 HorizontalOptions="Start"
                                 Margin="25,4,0,4" />

                        <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                            <Border x:Name="StageTwoTile" Grid.Column="0"
                                    WidthRequest="52" HeightRequest="52" Padding="0"
                                    BackgroundColor="{StaticResource SurfaceMuted}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>
                                <Path x:Name="StageTwoIcon"
                                      Data="{StaticResource IconDocument}"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform"
                                      WidthRequest="24" HeightRequest="24"
                                      HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Drafting the clinical note"
                                       Style="{StaticResource RowTitle}" />
                                <Label x:Name="StageTwoStatus"
                                       Style="{StaticResource RowMeta}" />
                            </VerticalStackLayout>

                            <Label x:Name="StageTwoMark" Grid.Column="2"
                                   FontSize="18" VerticalOptions="Center"
                                   TextColor="{StaticResource TextMuted}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ================================= FAILURE -->
                    <VerticalStackLayout x:Name="FailureView" Margin="20,26" Spacing="0" IsVisible="False">
                        <Border x:Name="FailureTile"
                                WidthRequest="72" HeightRequest="72" Padding="0"
                                BackgroundColor="{StaticResource TileWarning}"
                                StrokeThickness="0" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="36" />
                            </Border.StrokeShape>
                            <Path x:Name="FailureIcon"
                                  Data="{StaticResource IconWaveformClock}"
                                  Stroke="{StaticResource InkWarning}" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Aspect="Uniform"
                                  WidthRequest="32" HeightRequest="32"
                                  HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="FailureTitle"
                               FontFamily="PlayfairSemiBold" FontSize="21" LineHeight="1.35"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" Margin="0,14,0,0" />
                        <Label x:Name="FailureBody"
                               Style="{StaticResource Subtitle}" FontSize="12.5" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Retry, failure states only -->
                <Grid x:Name="RetryButton" Margin="0,20,0,0" HeightRequest="52" IsVisible="False">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRetryTapped" />
                    </Grid.GestureRecognizers>
                    <Border StrokeThickness="0" Background="{StaticResource ButtonGradient}" InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#665B2E9D" Offset="0,6" Radius="14" Opacity="0.55" />
                        </Border.Shadow>
                    </Border>
                    <Label Text="Try again"
                           FontFamily="InterSemiBold" FontSize="15" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Fill"
                           VerticalTextAlignment="Center" InputTransparent="True" />
                </Grid>

                <Button x:Name="SecondaryButton"
                        Style="{StaticResource GhostButton}"
                        TextColor="{StaticResource TextMuted}"
                        Clicked="OnSecondaryClicked"
                        Margin="0,6,0,0" IsVisible="False" />

                <!-- ============================== REASSURANCE -->
                <Grid x:Name="ReassuranceStrip" Margin="0,22,0,0" HeightRequest="86">
                    <Border BackgroundColor="{StaticResource TileNotice}"
                            StrokeThickness="0" InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                          Margin="16,0" VerticalOptions="Center" InputTransparent="True">
                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34" Padding="0"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource BrandPurple}" StrokeThickness="1.5"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Label Text="i" FontFamily="PlayfairBold" FontSize="17"
                                   TextColor="{StaticResource BrandPurple}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="This takes roughly as long as the consultation itself."
                                   FontFamily="InterSemiBold" FontSize="12"
                                   TextColor="{StaticResource BrandPurple}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="You can leave this screen — it carries on, and you can come back from the dashboard."
                                   FontFamily="InterRegular" FontSize="11" LineHeight="1.3"
                                   TextColor="{StaticResource BrandPurple}" Opacity="0.85"
                                   LineBreakMode="WordWrap" MaxLines="3" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
