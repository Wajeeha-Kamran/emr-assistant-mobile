<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EMRAssistant.Mobile.Controls"
             x:Class="EMRAssistant.Mobile.Views.SignPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">

    <!--
        Screen 9. The only irreversible action in the application.

        There is no red anywhere on this screen. Signing is the correct end of
        the workflow, not a hazard, and colouring it as a danger would frame the
        doctor's own signature as a mistake waiting to happen. The weight comes
        from the confirmation step and the wording.

        Signing and syncing are separate events and are reported separately. The
        signature is recorded immediately and cannot fail; the push to the EMR
        happens afterwards, in the background, and can. A screen that said
        "Done" the moment the button was pressed would be claiming something it
        does not yet know.
    -->

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="0" Spacing="0">

                <!-- ================================================ HEADER -->
                <Grid HeightRequest="210">
                    <Border StrokeThickness="0" InputTransparent="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#742AD8" Offset="0.0" />
                                <GradientStop Color="#30087C" Offset="0.55" />
                                <GradientStop Color="#100238" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,32,32" />
                        </Border.StrokeShape>
                    </Border>

                    <Grid RowDefinitions="Auto,*" Padding="18,16,18,0">
                        <!--
                            No back arrow. This is the last screen, and the only
                            reason to leave it before signing is to correct
                            something - which "Review the note again" does, and
                            says so. An arrow that only goes one place is better
                            written out in words.
                        -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Image Grid.Column="1" Source="logo_lockup_white.png"
                                   Aspect="AspectFit" HeightRequest="26" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="0,16,0,0"
                                             VerticalOptions="Start">
                            <Label x:Name="HeaderTitle" Text="Sign the note"
                                   FontFamily="PlayfairBold" FontSize="26"
                                   LineHeight="1.22" TextColor="White" />
                            <Label x:Name="HeaderMeta"
                                   FontFamily="InterRegular" FontSize="12"
                                   TextColor="#A6FFFFFF" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- ================================================== BODY -->
                <VerticalStackLayout Padding="14,0,14,20" Spacing="0"
                                     MaximumWidthRequest="520" HorizontalOptions="Fill">

                    <!-- Opening -->
                    <VerticalStackLayout x:Name="LoadingView" Margin="0,50,0,0" Spacing="14">
                        <controls:WaveformLoader HorizontalOptions="Center" Scale="0.7" />
                        <Label Text="Opening the note"
                               Style="{StaticResource Subtitle}" FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- ============================= BEFORE SIGNING ======= -->
                    <VerticalStackLayout x:Name="ReviewView" Spacing="0" IsVisible="False">

                        <!-- Note summary -->
                        <Grid Margin="0,-26,0,0">
                            <Border BackgroundColor="{StaticResource Surface}"
                                    StrokeThickness="0" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#1F241245" Offset="0,6" Radius="16" Opacity="0.55" />
                                </Border.Shadow>
                            </Border>
                            <VerticalStackLayout Margin="16,18" Spacing="0">
                                <Label Text="Note summary"
                                       FontFamily="PlayfairSemiBold" FontSize="20"
                                       TextColor="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10" />
                                <!-- The four sections and the code count, built in code -->
                                <VerticalStackLayout x:Name="SummaryHost" Spacing="0" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Review the note again"
                               FontFamily="InterSemiBold" FontSize="13"
                               TextColor="{StaticResource BrandPurple}"
                               HorizontalOptions="Center" Margin="0,14,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnReviewAgainTapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- What signing does -->
                        <Grid Margin="0,18,0,0">
                            <Border BackgroundColor="{StaticResource Surface}"
                                    StrokeThickness="0" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#1F241245" Offset="0,5" Radius="14" Opacity="0.45" />
                                </Border.Shadow>
                            </Border>
                            <VerticalStackLayout Margin="16,18" Spacing="0">
                                <Label Text="What happens when you sign"
                                       FontFamily="PlayfairSemiBold" FontSize="20"
                                       TextColor="{StaticResource TextPrimary}"
                                       Margin="0,0,0,12" />
                                <VerticalStackLayout x:Name="ConsequencesHost" Spacing="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ============================== AFTER SIGNING ======= -->
                    <VerticalStackLayout x:Name="SignedView" Margin="0,34,0,0" Spacing="0"
                                         IsVisible="False">
                        <Grid WidthRequest="92" HeightRequest="92" HorizontalOptions="Center">
                            <Border BackgroundColor="{StaticResource TileSecure}"
                                    StrokeThickness="0" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="46" />
                                </Border.StrokeShape>
                            </Border>
                            <Path Data="{StaticResource IconCheck}"
                                  Stroke="{StaticResource SecureGreen}" StrokeThickness="2.2"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent" Aspect="Uniform"
                                  WidthRequest="40" HeightRequest="40"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  InputTransparent="True" />
                        </Grid>

                        <Label Text="Note signed"
                               FontFamily="PlayfairBold" FontSize="24"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center" Margin="0,18,0,0" />
                        <Label x:Name="SignedMeta"
                               Style="{StaticResource Subtitle}" FontSize="12.5"
                               HorizontalTextAlignment="Center" Margin="0,6,0,0" />

                        <!-- The sync outcome, reported separately from the
                             signature because it is a separate event. -->
                        <Grid x:Name="SyncStrip" Margin="0,22,0,0">
                            <Border x:Name="SyncFill" BackgroundColor="{StaticResource TileAccent}"
                                    StrokeThickness="0" InputTransparent="True">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                            </Border>
                            <VerticalStackLayout Margin="16,14" Spacing="4">
                                <Label x:Name="SyncTitle" Text="Sending to the patient record system"
                                       FontFamily="InterSemiBold" FontSize="12.5"
                                       TextColor="{StaticResource InkAccent}" />
                                <Label x:Name="SyncBody"
                                       FontFamily="InterRegular" FontSize="11.5" LineHeight="1.35"
                                       TextColor="{StaticResource TextSecondary}"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel"
                           Style="{StaticResource Subtitle}" FontSize="12.5"
                           Margin="0,30,0,0" HorizontalTextAlignment="Center"
                           IsVisible="False" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================================================== FOOTER -->
        <Grid Grid.Row="1" Padding="14,10,14,16" RowDefinitions="Auto,Auto,Auto"
              RowSpacing="10" BackgroundColor="{StaticResource SurfaceMuted}">

            <!-- The deliberate step. A checkbox rather than a confirmation
                 dialog on top of it: one considered action, not two, and a
                 dialog stacked on a checkbox only teaches people to dismiss
                 dialogs. -->
            <Grid x:Name="ConfirmRow" Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                  BackgroundColor="Transparent" Padding="0,6">
                <!--
                    BackgroundColor="Transparent" is load-bearing. A layout with
                    no background of its own is not hit-tested, so the tap fell
                    straight through the row and the box could never be ticked.
                    The inner square carries its own recogniser as well, because
                    that is the part people aim at.
                -->
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConfirmToggled" />
                </Grid.GestureRecognizers>
                <Grid Grid.Column="0" WidthRequest="26" HeightRequest="26"
                      BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmToggled" />
                    </Grid.GestureRecognizers>
                    <Border x:Name="CheckBox" BackgroundColor="Transparent"
                            Stroke="{StaticResource BrandPurple}" StrokeThickness="2"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>
                    </Border>
                    <Path x:Name="CheckMark" Data="{StaticResource IconCheck}"
                          Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round"
                          Fill="Transparent" Aspect="Uniform"
                          WidthRequest="15" HeightRequest="15"
                          HorizontalOptions="Center" VerticalOptions="Center"
                          IsVisible="False" InputTransparent="True" />
                </Grid>
                <Label Grid.Column="1"
                       Text="I have reviewed this note and confirm it is accurate."
                       FontFamily="InterRegular" FontSize="12.5" LineHeight="1.35"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnConfirmToggled" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Grid Grid.Row="1" x:Name="PrimaryButton" HeightRequest="52"
                  BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPrimaryTapped" />
                </Grid.GestureRecognizers>
                <Border x:Name="PrimaryFill" StrokeThickness="0"
                        Background="{StaticResource ButtonGradient}" InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                </Border>
                <Label x:Name="PrimaryLabel" Text="Sign and send to the EMR"
                       FontFamily="InterSemiBold" FontSize="15" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Fill"
                       VerticalTextAlignment="Center" InputTransparent="True" />
            </Grid>

            <Label x:Name="FooterNote" Grid.Row="2"
                   Text="Signing cannot be undone. If something needs to change, correct it before signing."
                   FontFamily="InterRegular" FontSize="11" LineHeight="1.35"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />

            <!-- Shown when the button is pressed before the box is ticked. A
                 control that silently does nothing is indistinguishable from a
                 broken one. -->
            <Label x:Name="HintLabel" Grid.Row="2"
                   Text="Tick the box above to confirm you have reviewed the note."
                   FontFamily="InterSemiBold" FontSize="11" LineHeight="1.35"
                   TextColor="{StaticResource InkWarning}"
                   HorizontalTextAlignment="Center" IsVisible="False" />

            <!-- A bare Label only receives taps on the glyphs themselves. The
                 padded transparent Grid gives it a target worth aiming at. -->
            <Grid x:Name="SecondaryLabel" Grid.Row="2" IsVisible="False"
                  BackgroundColor="Transparent" Padding="20,10"
                  HorizontalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTapped" />
                </Grid.GestureRecognizers>
                <Label Text="Back to dashboard"
                       FontFamily="InterSemiBold" FontSize="13"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center" InputTransparent="True" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
