<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EMRAssistant.Mobile.Controls"
             xmlns:behaviors="clr-namespace:EMRAssistant.Mobile.Behaviors"
             x:Class="EMRAssistant.Mobile.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">

    <!--
        Sign in.

        Two items from the original design were removed because the backend
        cannot honour them: "Continue with hospital SSO" (no SSO endpoint, and
        real hospital SSO is a project of its own) and "Forgot password?" (no
        password-reset endpoint, and building one needs email delivery). A
        control that does nothing is worse than no control — it will be pressed
        during a demonstration.

        "Remember me" was kept because it is genuinely implementable: it decides
        whether the token persists between launches.
    -->

    <ScrollView>
        <Grid RowDefinitions="Auto,*">

            <!--
                The hero spans BOTH rows, so the artwork continues behind the
                card. This is what makes the frosted panel read as glass: a
                transparent surface over a flat colour just looks like a paler
                flat colour. The card sits on top in row 1.
            -->
            <Image Grid.Row="0" Grid.RowSpan="2"
                   Source="login_hero.png"
                   Aspect="AspectFill"
                   VerticalOptions="Fill"
                   Opacity="0.55" />

            <!-- The hero at full strength across the top; the faded copy
                 behind the card continues it downward. -->
            <Grid Grid.Row="0" HeightRequest="290">
                <Image Source="login_hero.png" Aspect="AspectFill" />

                <!-- The dark lockup is the variant intended for light
                     backgrounds, which is what the hero artwork provides. -->
                <Image Source="logo_lockup_dark.png"
                       Aspect="AspectFit"
                       HeightRequest="46"
                       HorizontalOptions="Start"
                       VerticalOptions="Start"
                       Margin="22,26,0,0" />
            </Grid>

            <!-- The card overlaps the hero, as in the design -->
            <Border Grid.Row="1"
                    Style="{StaticResource GlassCard}"
                    Margin="16,-60,16,28"
                    MaximumWidthRequest="460"
                    HorizontalOptions="Center">

                <VerticalStackLayout Spacing="16">

                    <!-- Poppins sits higher in its line box than the previous
                         font, so the ascenders touched the card edge. The margin
                         gives it room rather than relying on the card padding. -->
                    <Label Text="Welcome back, Doctor"
                           Style="{StaticResource DisplayTitle}"
                           FontSize="26"
                           Margin="0,10,0,0" />
                    <Label Text="Sign in to continue your clinical documentation."
                           Style="{StaticResource Subtitle}"
                           FontSize="12.5"
                           Margin="0,-10,0,6" />

                    <Label Text="Work email" Style="{StaticResource FieldLabel}" />
                    <controls:IconEntry x:Name="EmailField"
                                        Icon="{StaticResource IconMail}"
                                        Placeholder="name@clinic.com"
                                        KeyboardType="Email" />

                    <Label Text="Password" Style="{StaticResource FieldLabel}" />
                    <controls:IconEntry x:Name="PasswordField"
                                        Icon="{StaticResource IconLock}"
                                        Placeholder="Enter your password"
                                        IsPassword="True"
                                        Completed="OnSignInClicked" />

                    <HorizontalStackLayout Spacing="4" Margin="0,-7,0,-7">
                        <CheckBox x:Name="RememberMe"
                                  IsChecked="True"
                                  Color="{StaticResource BrandPurple}"
                                  VerticalOptions="Center" />
                        <Label Text="Keep me signed in"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Button x:Name="SignInButton"
                            Text="Sign in securely"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSignInClicked">
                        <Button.Behaviors>
                            <behaviors:HoverScaleBehavior />
                        </Button.Behaviors>
                    </Button>

                    <ActivityIndicator x:Name="Busy"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource BrandPurple}" />

                    <Border x:Name="MessageCard" Style="{StaticResource MessageCard}" IsVisible="False">
                        <Label x:Name="MessageLabel" FontSize="14" LineBreakMode="WordWrap" />
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,6,0,0">
                        <Label x:Name="NewHereLabel" Style="{StaticResource Subtitle}" FontSize="14" />
                        <Label Text="Create an account" Style="{StaticResource LinkLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreateAccountTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,0">
                        <Path Data="{StaticResource IconShield}"
                              Stroke="{StaticResource SecureGreen}"
                              StrokeThickness="1.5"
                              Fill="#141F8A5B"
                              Aspect="Uniform"
                              WidthRequest="13"
                              HeightRequest="13"
                              VerticalOptions="Center" />
                        <Label x:Name="AccessNoticeLabel" Style="{StaticResource FootnoteLabel}" />
                    </HorizontalStackLayout>

                    <!-- Shows which host the app is calling. Turns "it doesn't work"
                         into "it is pointed at the wrong machine" instantly. -->
                    <Label x:Name="ServerLabel" Style="{StaticResource FootnoteLabel}" FontSize="10.5" Margin="0,4,0,0" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
