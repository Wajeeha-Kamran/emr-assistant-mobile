<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EMRAssistant.Mobile.Controls"
             x:Class="EMRAssistant.Mobile.Views.ReviewPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource SurfaceMuted}">

    <!--
        Screen 7. One consultation, two views of it.

        SOAP Note is the default tab: it is the thing that becomes the clinical
        record, and the thing the doctor edits. Transcript is the evidence
        behind it, and is read-only — nothing in the SRS provides for editing a
        transcript, and the machine's raw output is worth keeping as it was
        produced. Corrections belong in the note.

        The section cards and transcript rows are built in the code-behind
        rather than in XAML: four near-identical blocks copied out by hand drift
        apart the first time one is edited.
    -->

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="0" Spacing="0">

                <!-- ============================================== HEADER -->
                <Grid HeightRequest="210">
                    <Border StrokeThickness="0" InputTransparent="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#742AD8" Offset="0.0" />
                                <GradientStop Color="#30087C" Offset="0.55" />
                                <GradientStop Color="#100238" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,32,32" />
                        </Border.StrokeShape>
                    </Border>

                    <Grid RowDefinitions="Auto,*" Padding="18,16,18,0">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <Grid Grid.Column="0" WidthRequest="38" HeightRequest="38">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackTapped" />
                                </Grid.GestureRecognizers>
                                <Border BackgroundColor="#26FFFFFF" StrokeThickness="0" InputTransparent="True">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="19" />
                                    </Border.StrokeShape>
                                </Border>
                                <Path Data="M15,5 L8,12 L15,19 M8,12 L21,12"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Aspect="Uniform"
                                      WidthRequest="17" HeightRequest="17"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>
                            <Image Grid.Column="2" Source="logo_lockup_white.png"
                                   Aspect="AspectFit" HeightRequest="26" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="0,16,0,0"
                                             VerticalOptions="Start">
                            <Label Text="Review consultation"
                                   FontFamily="PlayfairBold" FontSize="26"
                                   LineHeight="1.22" TextColor="White" />
                            <HorizontalStackLayout Spacing="8" Margin="0,10,0,0">
                                <Border BackgroundColor="#33FFFFFF" Padding="9,4" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label x:Name="StatusChip" Text="Draft"
                                           FontFamily="InterSemiBold" FontSize="10.5"
                                           TextColor="White" />
                                </Border>
                                <Label x:Name="HeaderMeta"
                                       FontFamily="InterRegular" FontSize="11.5"
                                       TextColor="#A6FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- ================================================ BODY -->
                <VerticalStackLayout Padding="14,0,14,20" Spacing="0"
                                     MaximumWidthRequest="520" HorizontalOptions="Fill">

                    <!-- Tabs -->
                    <Grid Margin="0,-28,0,0" HeightRequest="52" ColumnDefinitions="*,*"
                          HorizontalOptions="Fill">
                        <Border Grid.ColumnSpan="2" BackgroundColor="{StaticResource Surface}"
                                StrokeThickness="0" InputTransparent="True">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1F241245" Offset="0,6" Radius="16" Opacity="0.6" />
                            </Border.Shadow>
                        </Border>

                        <Grid Grid.Column="0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNoteTabTapped" />
                            </Grid.GestureRecognizers>
                            <Label x:Name="NoteTabLabel" Text="SOAP Note"
                                   FontFamily="InterSemiBold" FontSize="13.5"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <BoxView x:Name="NoteTabRule" HeightRequest="2.5" WidthRequest="72"
                                     Color="{StaticResource BrandPurple}"
                                     HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,7" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTranscriptTabTapped" />
                            </Grid.GestureRecognizers>
                            <Label x:Name="TranscriptTabLabel" Text="Transcript"
                                   FontFamily="InterSemiBold" FontSize="13.5"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <BoxView x:Name="TranscriptTabRule" HeightRequest="2.5" WidthRequest="72"
                                     Color="{StaticResource BrandPurple}"
                                     HorizontalOptions="Center" VerticalOptions="End"
                                     Margin="0,0,0,7" />
                        </Grid>
                    </Grid>

                    <!-- Loading -->
                    <VerticalStackLayout x:Name="LoadingView" Margin="0,40,0,0" Spacing="14">
                        <controls:WaveformLoader HorizontalOptions="Center" Scale="0.7" />
                        <Label Text="Opening the consultation"
                               Style="{StaticResource Subtitle}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- SOAP sections, built in code -->
                    <VerticalStackLayout x:Name="SectionsHost" Margin="0,18,0,0"
                                         Spacing="12" IsVisible="False" />

                    <!-- Transcript, built in code -->
                    <VerticalStackLayout x:Name="TranscriptHost" Margin="0,18,0,0"
                                         Spacing="0" IsVisible="False" />

                    <Label x:Name="MessageLabel"
                           Style="{StaticResource Subtitle}" FontSize="12.5"
                           Margin="0,24,0,0" IsVisible="False" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned action. The doctor should not have to scroll a long note to continue. -->
        <Grid Grid.Row="1" Padding="14,10,14,16" BackgroundColor="{StaticResource SurfaceMuted}">
            <Grid x:Name="ContinueButton" HeightRequest="52">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContinueTapped" />
                </Grid.GestureRecognizers>
                <Border StrokeThickness="0" Background="{StaticResource ButtonGradient}" InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#665B2E9D" Offset="0,6" Radius="14" Opacity="0.55" />
                    </Border.Shadow>
                </Border>
                <Label Text="Continue to codes"
                       FontFamily="InterSemiBold" FontSize="15" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Fill"
                       VerticalTextAlignment="Center" InputTransparent="True" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
